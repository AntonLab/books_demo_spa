# Copy to .env.local and fill in the credentials. .env.local is git-ignored.
NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=books_demo_spa
DB_USER=
DB_PASSWORD=

# Proxy hops to trust for the client address (X-Forwarded-For); 0 trusts none.
TRUST_PROXY=0

# Password-reset delivery; `log` writes reset links to the server log. Required in production.
RESET_DELIVERY=log

# Copy to .env.local and fill in the credentials. .env.local is git-ignored.
NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=books_demo_spa
DB_USER=
DB_PASSWORD=

# Proxy hops to trust for the client address (X-Forwarded-For); 0 trusts none.
TRUST_PROXY=0

# Where mail goes: `log` writes password-reset links and notification emails to
# the server log; `smtp` sends them through the SMTP_* settings. Required in
# production.
MAIL_DELIVERY=log
# Needed only with MAIL_DELIVERY=smtp (SMTP_PORT defaults to 587; 465 is TLS).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

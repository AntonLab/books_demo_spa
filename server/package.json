{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch ./src/index.ts",
    "start": "node ./src/index.ts",
    "seed": "node --env-file-if-exists=.env.local ./src/db/seed/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --env-file-if-exists=.env.local --test \"src/**/*.spec.ts\"",
    "posttest": "node --env-file-if-exists=.env.local ./src/db/dropTestDatabases.testkit.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "mysql2": "3.24.4",
    "sequelize": "6.37.8",
    "shared": "*",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6"
  }
}

{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "start": "node ./src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --env-file-if-exists=.env.local --test \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.0",
    "body-parser": "2.3.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "mysql2": "3.24.2",
    "sequelize": "6.37.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "nodemon": "3.1.14"
  }
}

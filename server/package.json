  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node ./src/index.ts",
    "start:dev": "nodemon ./src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --env-file-if-exists=.env.local --test \"src/**/*.spec.ts\"",

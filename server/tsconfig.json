{
  // Shared options (strict, skipLibCheck, the noUnused* family, …) live in the
  // root tsconfig.base.json. Only what is specific to the Node build is here.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}

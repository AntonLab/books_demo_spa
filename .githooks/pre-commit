#!/bin/sh
#
# Pre-commit: run ESLint (with --fix) and Prettier (with --write) over the
# staged files, re-stage whatever they rewrote, and block the commit if any
# ESLint error survives the autofix.
#
# Enabled per clone by `git config core.hooksPath .githooks`. The root
# package.json's `prepare` script runs that on every `npm install`, so a fresh
# clone picks the hook up as soon as the repo is installed. Bypass a single
# commit with `git commit --no-verify`.
#
# POSIX sh on purpose: Git for Windows runs hooks through its own sh. The repo
# is an npm workspace, so one root `node_modules/.bin` holds both tools.
#
# ESLint runs once per package because flat config does not cascade — each
# package's eslint.config.mjs must be the working directory's config. Prettier
# runs once from the repo root, because its config is repo-wide (see CLAUDE.md).

set -u

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

status=0
bin="$repo_root/node_modules/.bin"

# Deletions are excluded (--diff-filter=ACMR): there is nothing left on disk to
# lint or format. core.quotepath=false keeps non-ASCII paths unescaped so they
# survive the round trip through these list files.
git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR >"$work/staged"
[ -s "$work/staged" ] || exit 0

# A file that is staged *and* dirty in the working tree cannot be handled
# safely: the tools rewrite the working-tree copy, so `git add` would sweep the
# unstaged hunks into the commit as well. Stop rather than guess.
git -c core.quotepath=false diff --name-only >"$work/dirty"
grep -Fxf "$work/dirty" "$work/staged" >"$work/partial" 2>/dev/null
if [ -s "$work/partial" ]; then
  echo "pre-commit: these files are only partially staged:"
  sed 's/^/  /' "$work/partial"
  echo
  echo "Formatting them would pull the unstaged changes into the commit too."
  echo "Stage them fully, stash the rest, or commit with --no-verify."
  exit 1
fi

# One root install covers both workspaces, so one probe covers both tools.
if [ ! -x "$bin/prettier" ]; then
  echo "pre-commit: node_modules is missing, so the staged files went"
  echo "            unchecked. Run \`npm install\` at the repo root."
  exit 0
fi

# Runs one tool over one file list, from inside one directory.
#   $1 directory to run in, relative to the repo root
#   $2 executable (absolute, so the cd cannot strand it)
#   $3 list file holding paths relative to that directory
#   $4.. extra flags for the tool
run_tool() {
  rt_dir=$1
  rt_bin=$2
  rt_list=$3
  shift 3

  [ -s "$rt_list" ] || return 0

  # Positional parameters now hold the tool's flags; append the files after
  # them, then run the whole thing in a subshell so the cd does not stick.
  while IFS= read -r rt_line; do
    [ -n "$rt_line" ] && set -- "$@" "$rt_line"
  done <"$rt_list"

  ( cd "$rt_dir" && "$rt_bin" "$@" )
}

# ESLint understands the script extensions only.
lintable() {
  grep -Ei '\.(ts|tsx|js|jsx|mjs|cjs)$' "$1" >"$2"
  return 0
}

# Lints one package's staged files from inside that package, so ESLint picks up
# that package's flat config.
#   $1 package directory, $2 list file with paths relative to that directory
lint_package() {
  lp_dir=$1
  lp_list=$2

  lintable "$lp_list" "$work/lintable"
  # --no-warn-ignored: a staged file the package's config ignores is not an
  # error, it just has nothing to say about it.
  run_tool "$lp_dir" "$bin/eslint" "$work/lintable" \
    --fix --no-warn-ignored || status=1
}

grep '^client/' "$work/staged" | sed 's|^client/||' >"$work/client"
grep '^server/' "$work/staged" | sed 's|^server/||' >"$work/server"

lint_package client "$work/client"
lint_package server "$work/server"

# Prettier runs once over every staged file, from the repo root: one
# .prettierrc.json and one .prettierignore cover the whole repo, including the
# root-level configs and markdown that no package's ESLint config reaches.
# --ignore-unknown skips what it cannot parse.
run_tool . "$bin/prettier" "$work/staged" \
  --write --ignore-unknown --log-level warn || status=1

# Re-stage unconditionally: when the commit is about to be blocked the fixes
# are still worth keeping, so they land in the next attempt instead of being
# left loose in the working tree.
run_tool . git "$work/staged" add --

exit $status

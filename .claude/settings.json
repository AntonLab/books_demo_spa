{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": ["**/.claude/worktrees/**/CLAUDE.md"],
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git"
      }
    },
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/juliusbrussee/caveman.git"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "caveman@caveman": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx jest *)",
      "Bash(node --test *)",
      "Bash(node --env-file-if-exists=.env.local --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git check-ignore *)"
    ],
    "ask": [
      "Bash(npm *seed*)",
      "Bash(node *seed.ts*)",
      "PowerShell(npm *seed*)",
      "PowerShell(node *seed.ts*)"
    ],
    "deny": ["Edit(**/.env.local)", "Edit(package-lock.json)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited.mjs"
          }
        ]
      }
    ]
  }
}

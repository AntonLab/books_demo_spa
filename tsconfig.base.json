{
  // Shared compiler options for both workspaces. `client/` and `server/` extend
  // this with a relative path, which is a file lookup rather than a module
  // resolution, so it needs nothing installed.
  //
  // Only options with the same value in both packages belong here. Note that
  // `include`, `exclude` and `paths` must NOT: TypeScript resolves those
  // relative to the file that declares them, so listing `src` here would point
  // every package at the repo root's `src`. Keep them in the package configs.
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    // Node strips types rather than compiling them (the server and `shared`,
    // ADR-0006): no enums, namespaces or parameter properties, and every
    // type-only import marked `type`, or it survives into the runtime import
    // and fails to link. An ambient `const enum` from a dependency is refused
    // too. The client is held to the same so code moves between packages.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // An index read (`items[i]`, `record[key]`) is typed `T | undefined`, as
    // it can be at runtime. Application code handles the miss — an early
    // return, a throw naming what was missing, or `?.`/`??` where absence is
    // legitimate. Only test files (*.spec.ts, *.test.ts(x), *.testkit.ts,
    // client/src/test/) may assert it away with `!`, since a miss there fails
    // the test anyway.
    "noUncheckedIndexedAccess": true
  }
}

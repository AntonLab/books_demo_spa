{
  // Shared compiler options for both packages. `client/` and `server/` extend
  // this with a relative path; there is no root package.json and none is needed,
  // because `extends` is a file lookup rather than a module resolution.
  //
  // Only options with the same value in both packages belong here. Note that
  // `include`, `exclude` and `paths` must NOT: TypeScript resolves those
  // relative to the file that declares them, so listing `src` here would point
  // every package at the repo root's `src`. Keep them in the package configs.
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}

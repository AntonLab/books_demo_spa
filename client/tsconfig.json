{
  // Shared options (strict, skipLibCheck, the noUnused* family, …) live in the
  // root tsconfig.base.json. Only what is specific to the browser build is here.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    // `@/…` maps to `src/…`. Three tools must agree on this: tsc (here),
    // webpack (`resolve.alias`) and Jest (`moduleNameMapper`). No `baseUrl`:
    // it is deprecated in TS 6, and `moduleResolution: Bundler` resolves
    // `paths` against this file's directory without it.
    "paths": { "@/*": ["./src/*"] },
    "noEmit": true,
    // Not for this package's own imports, which stay extensionless: the
    // `shared` workspace is type-checked as part of this program, and its
    // relative imports end in `.ts` because Node loads it too (ADR-0006).
    "allowImportingTsExtensions": true,
    "isolatedModules": true
  },
  "include": ["src"]
}

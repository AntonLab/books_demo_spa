{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    // `@/…` maps to `src/…`. Three tools must agree on this: tsc (here),
    // webpack (`resolve.alias`) and Jest (`moduleNameMapper`). No `baseUrl`:
    // it is deprecated in TS 6, and `moduleResolution: Bundler` resolves
    // `paths` against this file's directory without it.
    "paths": { "@/*": ["./src/*"] },

    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}

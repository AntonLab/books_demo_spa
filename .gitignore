# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# `client/` and `server/` are npm workspaces under one root package.json, but each
# still builds into its own directory, so the rules below are written to match at
# any depth rather than being repeated per package.

# dependencies
node_modules/

# testing
coverage/

# build output — `client` emits build/, `server` emits dist/
build/
dist/

# misc
.DS_Store
npm-debug.log*

# local environment / secrets (server reads .env.local; .env.example is checked in)
.env*.local

# agent skills — materialized from skills-lock.json via `npx skills`
# (.claude holds machine-specific absolute symlinks into .agents/, plus the
# git worktrees created for isolated task execution). The exception is
# .claude/agents/, the checked-in plan pipeline agents; `/.claude/*` matches
# direct children only, so un-ignoring that directory lets its files through.
/.agents
/.claude/*
!/.claude/agents/

# agent working notes — plans and specs generated per task, not project docs.
# Two exceptions are checked in: docs/agents/ configures the engineering skills,
# and docs/adr/ holds the architecture decision records those skills are told to
# read. `/docs/*` matches direct children only, so un-ignoring a directory is
# enough to let the files inside it through.
/docs/*
!/docs/agents/
!/docs/adr/

# subagent-driven-development scratch (ledger, briefs, review packages)
/.superpowers

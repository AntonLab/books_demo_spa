# Tool output and secrets only; OS/editor files go in ~/.config/git/ignore.

# Dependencies and build output
node_modules/
coverage/
/client/build/
/server/dist/

# Secrets (.env.local holds the DB credentials)
.env*

# Claude Code, per clone: restored skills (db-reset is checked in), agents,
# worktrees, personal settings
/.agents/
/.claude/agents/
/.claude/skills/*
!/.claude/skills/db-reset/
/.claude/worktrees/
/.claude/settings.local.json

# Agent scratch (docs/agents/ and docs/adr/ are real docs)
/docs/*
!/docs/agents/
!/docs/adr/
/.superpowers/
/.playwright-mcp/
/.fallow/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# There is no root package.json: `client/` and `server/` are installed and built
# separately, so the rules below are written to match at any depth rather than
# being repeated per package.

# dependencies
node_modules/

# testing
coverage/

# build output — `client` emits build/, `server` emits dist/
build/
dist/

# misc
.DS_Store
npm-debug.log*

# local environment / secrets (server reads .env.local; .env.example is checked in)
.env*.local

# agent skills — materialized from skills-lock.json via `npx skills`
# (.claude holds machine-specific absolute symlinks into .agents/, plus the
# git worktrees created for isolated task execution)
/.agents
/.claude

# agent working notes — plans and specs generated per task, not project docs.
# docs/agents/ is the exception: it configures the engineering skills, so it is
# checked in. `/docs/*` matches direct children only, so un-ignoring the
# directory is enough to let the files inside it through.
/docs/*
!/docs/agents/

# subagent-driven-development scratch (ledger, briefs, review packages)
/.superpowers

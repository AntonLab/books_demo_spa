# Tool output and secrets only; OS/editor files go in ~/.config/git/ignore.
node_modules/
coverage/
build/
dist/
.env
.env.*
!.env.example

# Per clone: restored skills (db-reset is checked in), agents, worktrees
/.agents/
/.claude/agents/
/.claude/skills/*
!/.claude/skills/db-reset/
/.claude/worktrees/
/.claude/settings.local.json

# Agent scratch; docs/agents/ and docs/adr/ are real docs
/docs/*
!/docs/agents/
!/docs/adr/
/.superpowers
/.playwright-mcp

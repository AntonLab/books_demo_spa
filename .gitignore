# `client/`, `server/` and `shared/` are npm workspaces under one root
# package.json, but each still builds into its own directory, so the rules
# below are written to match at any depth rather than being repeated per package.
#
# Only what this repo's own tools produce, or a secret, belongs here. Files a
# contributor's OS or editor leaves behind (.DS_Store, Thumbs.db, .vscode/)
# go in their global excludes file, ~/.config/git/ignore.

# dependencies
node_modules/

# testing — Jest writes coverage/ when run with --coverage
coverage/

# build output — `client` emits build/, `server` emits dist/
build/
dist/

# local environment / secrets — any .env file, however it is named, stays out
# (the server reads .env.local); the example is the one checked in
.env
.env.*
!.env.example

# agent skills — materialized from skills-lock.json via `npm run skills`
# (.claude holds machine-specific absolute symlinks into .agents/, plus the
# git worktrees created for isolated task execution). The exception is
# .claude/agents/, the checked-in plan pipeline agents; `/.claude/*` matches
# direct children only, so un-ignoring that directory lets its files through.
/.agents
/.claude/*
!/.claude/agents/

# agent working notes — plans and specs generated per task, not project docs.
# Two exceptions are checked in: docs/agents/ configures the engineering skills,
# and docs/adr/ holds the architecture decision records those skills are told to
# read. `/docs/*` matches direct children only, so un-ignoring a directory is
# enough to let the files inside it through.
/docs/*
!/docs/agents/
!/docs/adr/

# subagent-driven-development scratch (ledger, briefs, review packages)
/.superpowers

{
  // Shared options (strict, skipLibCheck, the noUnused* family, …) live in the
  // root tsconfig.base.json. This package is TypeScript source with no build:
  // the client's bundler and the server's Node both load `src/` as written
  // (ADR-0006), so what is here is what keeps it loadable by both.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The client's level, the lower of the two consumers, so nothing here
    // reaches for an API the browser build does not declare.
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Node's type stripping resolves imports exactly as written, so relative
    // imports carry `.ts`, as they do in the server.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
